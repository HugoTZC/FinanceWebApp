{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontEnd/",
      "framework": "nextjs"
    },
    "python_api": {
      "root": "pythonApi/",
      "entrypoint": "app:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/v2",
      "destination": {
        "service": "python_api"
      }
    },
    {
      "source": "/api/v2/(.*)",
      "destination": {
        "service": "python_api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
